{
  "version": 1,
  "claude": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "command": "\"$HOME/.claude/hooks/guard_file.py\" prompt",
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"$HOME/.claude/hooks/verification_session.py\" claude pre-tool-use",
            "type": "command",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "command": "\"$HOME/.claude/hooks/audit_log.py\" tool claude",
            "type": "command"
          },
          {
            "command": "\"$HOME/.claude/hooks/guard_command.py\" forbidden",
            "type": "command"
          },
          {
            "command": "\"$HOME/.claude/hooks/guard_file.py\" commit",
            "type": "command"
          },
          {
            "command": "\"$HOME/.claude/hooks/guard_git.py\"",
            "type": "command"
          },
          {
            "command": "\"$HOME/.claude/hooks/guard_command.py\" allowed",
            "type": "command"
          }
        ]
      },
      {
        "matcher": "Read|Grep",
        "hooks": [
          {
            "command": "\"$HOME/.claude/hooks/audit_log.py\" tool claude",
            "type": "command"
          },
          {
            "command": "\"$HOME/.claude/hooks/guard_file.py\" read",
            "type": "command"
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "command": "\"$HOME/.claude/hooks/audit_log.py\" tool claude",
            "type": "command"
          },
          {
            "command": "\"$HOME/.claude/hooks/guard_file.py\" harness",
            "type": "command"
          },
          {
            "command": "\"$HOME/.claude/hooks/guard_file.py\" write",
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "command": "\"$HOME/.claude/hooks/lint_format.py\"",
            "type": "command"
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|WebFetch|WebSearch|Task|Agent",
        "hooks": [
          {
            "command": "\"$HOME/.claude/hooks/audit_log.py\" tool claude",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "command": "\"$HOME/.claude/hooks/verification_session.py\" claude stop",
            "type": "command",
            "timeout": 600
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "command": "\"$HOME/.claude/hooks/audit_log.py\" denied claude",
            "type": "command"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "command": "\"$HOME/.claude/hooks/audit_log.py\" compaction claude",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "\"$HOME/.claude/hooks/verification_session.py\" claude session-start",
            "type": "command",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "compact|resume",
        "hooks": [
          {
            "command": "\"$HOME/.claude/hooks/audit_log.py\" compaction claude",
            "type": "command"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "\"$HOME/.claude/hooks/verification_session.py\" claude session-end",
            "type": "command",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "codex": {
    "hooks": {
      "SessionStart": [
        {
          "hooks": [
            {
              "command": "\"$HOME/.claude/hooks/verification_session.py\" codex session-start",
              "type": "command",
              "timeout": 30,
              "statusMessage": "Registering verification session"
            }
          ]
        }
      ],
      "SessionEnd": [
        {
          "hooks": [
            {
              "command": "\"$HOME/.claude/hooks/verification_session.py\" codex session-end",
              "type": "command",
              "timeout": 3,
              "statusMessage": "Retaining verification state"
            }
          ]
        }
      ],
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "command": "\"$HOME/.codex/hooks/hook_adapter.py\" content prompt",
              "statusMessage": "Scanning prompt for sensitive information",
              "timeout": 30,
              "type": "command"
            }
          ]
        }
      ],
      "PreToolUse": [
        {
          "matcher": ".",
          "hooks": [
            {
              "command": "\"$HOME/.claude/hooks/verification_session.py\" codex pre-tool-use",
              "type": "command",
              "timeout": 30,
              "statusMessage": "Checking verification registration"
            }
          ]
        },
        {
          "matcher": "^(Bash|exec_command|functions\\.exec_command)$",
          "hooks": [
            {
              "command": "\"$HOME/.codex/hooks/hook_adapter.py\" paths command",
              "statusMessage": "Checking secret path policy",
              "timeout": 30,
              "type": "command"
            },
            {
              "command": "\"$HOME/.codex/hooks/hook_adapter.py\" shell forbidden",
              "statusMessage": "Checking forbidden command prefixes",
              "timeout": 30,
              "type": "command"
            },
            {
              "command": "\"$HOME/.codex/hooks/hook_adapter.py\" shell commit",
              "statusMessage": "Checking staged files for secrets",
              "timeout": 30,
              "type": "command"
            },
            {
              "command": "\"$HOME/.codex/hooks/hook_adapter.py\" shell git",
              "statusMessage": "Checking for dangerous git operations",
              "timeout": 30,
              "type": "command"
            },
            {
              "command": "\"$HOME/.codex/hooks/hook_adapter.py\" shell allowed",
              "statusMessage": "Checking command permissions",
              "timeout": 30,
              "type": "command"
            }
          ]
        },
        {
          "matcher": "^apply_patch$|^Edit$|^Write$",
          "hooks": [
            {
              "command": "\"$HOME/.codex/hooks/hook_adapter.py\" paths patch",
              "statusMessage": "Checking secret path policy",
              "timeout": 30,
              "type": "command"
            },
            {
              "command": "\"$HOME/.codex/hooks/hook_adapter.py\" harness",
              "statusMessage": "Checking harness boundaries",
              "timeout": 30,
              "type": "command"
            },
            {
              "command": "\"$HOME/.codex/hooks/hook_adapter.py\" content apply-patch",
              "statusMessage": "Scanning patch for sensitive information",
              "timeout": 30,
              "type": "command"
            }
          ]
        }
      ],
      "PostToolUse": [
        {
          "matcher": "^apply_patch$|^Edit$|^Write$",
          "hooks": [
            {
              "command": "\"$HOME/.codex/hooks/hook_adapter.py\" lint",
              "statusMessage": "Running lint/format hooks",
              "timeout": 120,
              "type": "command"
            }
          ]
        },
        {
          "matcher": ".",
          "hooks": [
            {
              "command": "\"$HOME/.claude/hooks/audit_log.py\" tool codex",
              "statusMessage": "Logging tool call",
              "timeout": 10,
              "type": "command"
            }
          ]
        }
      ],
      "Stop": [
        {
          "hooks": [
            {
              "command": "\"$HOME/.claude/hooks/verification_session.py\" codex stop",
              "statusMessage": "Verifying session changes",
              "timeout": 600,
              "type": "command"
            }
          ]
        }
      ]
    }
  },
