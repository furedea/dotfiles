{
  "version": 1,
  "claude": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "command": "\"$HOME/.claude/hooks/guard_files.py\" prompt",
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "command": "\"$HOME/.claude/hooks/audit_events.py\" tool",
            "type": "command"
          },
          {
            "command": "\"$HOME/.claude/hooks/guard_commands.py\" forbidden",
            "type": "command"
          },
          {
            "command": "\"$HOME/.claude/hooks/guard_files.py\" commit",
            "type": "command"
          },
          {
            "command": "\"$HOME/.claude/hooks/guard_dangerous_git.py\"",
            "type": "command"
          },
          {
            "command": "\"$HOME/.claude/hooks/guard_commands.py\" allowed",
            "type": "command"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "command": "\"$HOME/.claude/hooks/audit_events.py\" tool",
            "type": "command"
          },
          {
            "command": "\"$HOME/.claude/hooks/guard_files.py\" read",
            "type": "command"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "command": "\"$HOME/.claude/hooks/audit_events.py\" tool",
            "type": "command"
          },
          {
            "command": "\"$HOME/.claude/hooks/guard_files.py\" harness",
            "type": "command"
          },
          {
            "command": "\"$HOME/.claude/hooks/guard_files.py\" write",
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "command": "\"$HOME/.claude/hooks/lint_format.py\" py",
            "if": "Write(*.py)|Edit(*.py)|MultiEdit(*.py)",
            "type": "command"
          },
          {
            "command": "\"$HOME/.claude/hooks/lint_format.py\" sh",
            "if": "Write(*.sh)|Edit(*.sh)|MultiEdit(*.sh)",
            "type": "command"
          },
          {
            "command": "\"$HOME/.claude/hooks/lint_format.py\" js",
            "if": "Write(*.js)|Edit(*.js)|MultiEdit(*.js)|Write(*.ts)|Edit(*.ts)|MultiEdit(*.ts)|Write(*.jsx)|Edit(*.jsx)|MultiEdit(*.jsx)|Write(*.tsx)|Edit(*.tsx)|MultiEdit(*.tsx)",
            "type": "command"
          },
          {
            "command": "\"$HOME/.claude/hooks/lint_format.py\" rs",
            "if": "Write(*.rs)|Edit(*.rs)|MultiEdit(*.rs)",
            "type": "command"
          },
          {
            "command": "\"$HOME/.claude/hooks/lint_format.py\" nix",
            "if": "Write(*.nix)|Edit(*.nix)|MultiEdit(*.nix)",
            "type": "command"
          },
          {
            "command": "\"$HOME/.claude/hooks/lint_format.py\" md",
            "if": "Write(*.md)|Edit(*.md)|MultiEdit(*.md)|Write(*.markdown)|Edit(*.markdown)|MultiEdit(*.markdown)",
            "type": "command"
          },
          {
            "command": "\"$HOME/.claude/hooks/lint_format.py\" json_toml",
            "if": "Write(*.json)|Edit(*.json)|MultiEdit(*.json)|Write(*.toml)|Edit(*.toml)|MultiEdit(*.toml)",
            "type": "command"
          },
          {
            "command": "\"$HOME/.claude/hooks/lint_format.py\" gha",
            "if": "Write(*.yml)|Edit(*.yml)|MultiEdit(*.yml)|Write(*.yaml)|Edit(*.yaml)|MultiEdit(*.yaml)",
            "type": "command"
          },
          {
            "command": "\"$HOME/.claude/hooks/lint_format.py\" txt",
            "if": "Write(*.txt)|Edit(*.txt)|MultiEdit(*.txt)",
            "type": "command"
          },
          {
            "command": "\"$HOME/.claude/hooks/lint_format.py\" lua",
            "if": "Write(*.lua)|Edit(*.lua)|MultiEdit(*.lua)",
            "type": "command"
          },
          {
            "command": "\"$HOME/.claude/hooks/lint_format.py\" tex",
            "if": "Write(*.tex)|Edit(*.tex)|MultiEdit(*.tex)|Write(*.bib)|Edit(*.bib)|MultiEdit(*.bib)|Write(*.cls)|Edit(*.cls)|MultiEdit(*.cls)|Write(*.sty)|Edit(*.sty)|MultiEdit(*.sty)",
            "type": "command"
          }
        ]
      },
      {
        "matcher": "Bash|Edit|MultiEdit|Write|WebFetch|WebSearch|Task|Agent",
        "hooks": [
          {
            "command": "\"$HOME/.claude/hooks/audit_events.py\" tool",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "command": "\"$HOME/.claude/hooks/run_related_tests.py\"",
            "type": "command"
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "command": "\"$HOME/.claude/hooks/audit_events.py\" denied",
            "type": "command"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "command": "\"$HOME/.claude/hooks/audit_events.py\" compaction",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|resume",
        "hooks": [
          {
            "command": "\"$HOME/.claude/hooks/audit_events.py\" compaction",
            "type": "command"
          }
        ]
      }
    ]
  },
  "codex": {
    "hooks": {
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "command": "\"$HOME/.codex/hooks/adapters.py\" content prompt",
              "statusMessage": "Scanning prompt for sensitive information",
              "timeout": 30,
              "type": "command"
            }
          ]
        }
      ],
      "PreToolUse": [
        {
          "matcher": "^(Bash|exec_command|functions\\.exec_command)$",
          "hooks": [
            {
              "command": "\"$HOME/.codex/hooks/adapters.py\" paths command",
              "statusMessage": "Checking secret path policy",
              "timeout": 30,
              "type": "command"
            },
            {
              "command": "\"$HOME/.codex/hooks/adapters.py\" shell forbidden",
              "statusMessage": "Checking forbidden command prefixes",
              "timeout": 30,
              "type": "command"
            },
            {
              "command": "\"$HOME/.codex/hooks/adapters.py\" shell commit",
              "statusMessage": "Checking staged files for secrets",
              "timeout": 30,
              "type": "command"
            },
            {
              "command": "\"$HOME/.codex/hooks/adapters.py\" shell git",
              "statusMessage": "Checking for dangerous git operations",
              "timeout": 30,
              "type": "command"
            },
            {
              "command": "\"$HOME/.codex/hooks/adapters.py\" shell allowed",
              "statusMessage": "Checking command permissions",
              "timeout": 30,
              "type": "command"
            }
          ]
        },
        {
          "matcher": "^apply_patch$|^Edit$|^Write$",
          "hooks": [
            {
              "command": "\"$HOME/.codex/hooks/adapters.py\" paths patch",
              "statusMessage": "Checking secret path policy",
              "timeout": 30,
              "type": "command"
            },
            {
              "command": "\"$HOME/.codex/hooks/adapters.py\" harness",
              "statusMessage": "Checking harness boundaries",
              "timeout": 30,
              "type": "command"
            },
            {
              "command": "\"$HOME/.codex/hooks/adapters.py\" content apply-patch",
              "statusMessage": "Scanning patch for sensitive information",
              "timeout": 30,
              "type": "command"
            }
          ]
        }
      ],
      "PostToolUse": [
        {
          "matcher": "^apply_patch$|^Edit$|^Write$",
          "hooks": [
            {
              "command": "\"$HOME/.codex/hooks/adapters.py\" lint",
              "statusMessage": "Running lint/format hooks",
              "timeout": 120,
              "type": "command"
            }
          ]
        },
        {
          "matcher": ".",
          "hooks": [
            {
              "command": "\"$HOME/.claude/hooks/audit_events.py\" tool",
              "statusMessage": "Logging tool call",
              "timeout": 10,
              "type": "command"
            }
          ]
        }
      ],
      "Stop": [
        {
          "hooks": [
            {
              "command": "\"$HOME/.claude/hooks/run_related_tests.py\"",
              "statusMessage": "Running related tests",
              "timeout": 600,
              "type": "command"
            }
          ]
        }
      ]
    }
  }
}
