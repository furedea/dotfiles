{
  "version": 1,
  "rules": [
    {
      "programs": [
        "gh"
      ],
      "patterns": [
        "^gh api repos/[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+/pulls/[0-9]+/comments( --paginate)?$",
        "^gh api repos/[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+/pulls/[0-9]+/comments( --paginate)? --jq '[^']*'$",
        "^gh api repos/[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+/issues/[0-9]+/comments( --paginate)?$",
        "^gh api repos/[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+/issues/[0-9]+/comments( --paginate)? --jq '[^']*'$",
        "^gh api repos/[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+/pulls/[0-9]+/comments/[0-9]+/replies -f body='[^']*('\\\\''[^']*)*'$",
        "^gh api repos/[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+/pulls/[0-9]+/reviews( --paginate)?$",
        "^gh api repos/[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+/pulls/[0-9]+/reviews( --paginate)? --jq '[^']*'$",
        "^gh api repos/[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+/pulls/[0-9]+/reviews/[0-9]+/comments( --paginate)?$",
        "^gh api repos/[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+/pulls/[0-9]+/reviews/[0-9]+/comments( --paginate)? --jq '[^']*'$",
        "^gh api repos/[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+ --method POST -f parent_issue_id=[a-zA-Z0-9_=]+ /issues/[0-9]+/sub_issues$",
        "^gh api graphql -f query='(query([[:space:]({{])|[{])[^']*('\\\\''[^']*)*'$",
        "^gh api ('[^']*'|[^ '-][^ ']*)( --paginate| --slurp| -i| --include| --jq ('[^']*'|[^' ]+)| -q ('[^']*'|[^' ]+)| -H '[^']*'| --cache [0-9]+[smh])*$",
        "^gh issue (list|status|view)( |$)",
        "^gh issue (create|comment|develop|edit|reopen|close)( |$)",
        "^gh label (list|create)( |$)",
        "^gh pr list( |$)",
        "^gh pr status( |$)",
        "^gh pr checks( |$)",
        "^gh pr diff( |$)",
        "^gh pr view( |$)",
        "^gh pr create( |$)",
        "^gh pr checkout( |$)",
        "^gh pr comment( |$)",
        "^gh pr edit( |$)",
        "^gh pr ready( |$)",
        "^gh pr close( |$)",
        "^gh pr reopen( |$)",
        "^gh pr review( [0-9]+)? (--comment|--request-changes)( [^;&|<>$`]+)?$",
        "^gh run (list|view|watch|rerun|download|cancel)( |$)",
        "^gh repo view( |$)",
        "^gh repo clone [A-Za-z0-9_./-]+( [A-Za-z0-9._/-]+)?$",
        "^gh stack view( -s| --short)?$",
        "^gh stack init [a-zA-Z0-9_./][a-zA-Z0-9_./-]*( [a-zA-Z0-9_./][a-zA-Z0-9_./-]*)*$",
        "^gh stack add [a-zA-Z0-9_./][a-zA-Z0-9_./-]*$",
        "^gh stack submit --auto( --open)?$",
        "^gh stack push$",
        "^gh stack sync$",
        "^gh stack rebase( --continue| --abort)?$"
      ],
      "justification": "Allow GitHub reads and the reviewable writes the delivery workflow uses; other forms of an approved gh prefix change GitHub in ways the sandbox cannot undo."
    },
    {
      "programs": [
        "curl",
        "wget"
      ],
      "patterns": [
        "^curl( -[A-Za-z]+)*( -X (GET|POST|PUT|PATCH|DELETE))?( -H '[^']*')*( -d '[^']*')?( -o [A-Za-z0-9._/-]+)? https?://(localhost|127\\.0\\.0\\.1)(:[0-9]+)?[A-Za-z0-9._/?&=%-]*$",
        "^wget( -[A-Za-z]+)*( -O [A-Za-z0-9._/-]+)? https?://(localhost|127\\.0\\.0\\.1)(:[0-9]+)?[A-Za-z0-9._/?&=%-]*$"
      ],
      "justification": "Allow requests to local servers; remote fetches leave the machine."
    },
    {
      "programs": [
        "herdr"
      ],
      "patterns": [
        "^herdr status( |$)",
        "^herdr --help( |$)",
        "^herdr --version( |$)",
        "^herdr pane list( |$)",
        "^herdr pane read( |$)",
        "^herdr pane current( |$)",
        "^herdr plugin list( |$)",
        "^herdr plugin log( |$)",
        "^herdr config check( |$)",
        "^herdr agent list( |$)",
        "^herdr api snapshot( |$)",
        "^herdr worktree create( --(cwd|branch|base|path|label|workspace) ('[^']*'|\"([^\"\\\\]|\\\\.)*\"|[^ '\"]+)| --(no-)?focus)*$",
        "^herdr pane split( --(pane|direction|ratio|cwd) ('[^']*'|\"([^\"\\\\]|\\\\.)*\"|[^ '\"]+)| --current| --(no-)?focus)*$",
        "^herdr agent start [a-z][a-z0-9_-]*( --kind (claude|codex)| --pane [^ ]+| --timeout [0-9]+)+$",
        "^herdr agent prompt [a-z][a-z0-9_-]* ('[^']*'|\"([^\"\\\\]|\\\\.)*\"|[^ '\"]+)( --wait| --until [a-z]+| --timeout [0-9]+)*$",
        "^herdr workspace close [^ -][^ ]*$",
        "^herdr worktree remove --workspace [^ -][^ ]*$",
        "^herdr workspace list( |$)",
        "^herdr workspace get( |$)"
      ],
      "justification": "Allow Herdr reads and handing work to a new Claude or Codex session; repository trust, pane environments, other agent kinds, and driving existing panes run outside the sandbox and ask."
    }
  ]
}
