{
  "version": 1,
  "rules": [
    {
      "programs": [
        "gh"
      ],
      "patterns": [
        "^gh api repos/[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+/pulls/[0-9]+/comments( --paginate)?$",
        "^gh api repos/[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+/pulls/[0-9]+/comments( --paginate)? --jq '[^']*'$",
        "^gh api repos/[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+/issues/[0-9]+/comments( --paginate)?$",
        "^gh api repos/[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+/issues/[0-9]+/comments( --paginate)? --jq '[^']*'$",
        "^gh api repos/[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+/pulls/[0-9]+/comments/[0-9]+/replies -f body='[^']*('\\\\''[^']*)*'$",
        "^gh api repos/[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+/pulls/[0-9]+/reviews( --paginate)?$",
        "^gh api repos/[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+/pulls/[0-9]+/reviews( --paginate)? --jq '[^']*'$",
        "^gh api repos/[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+/pulls/[0-9]+/reviews/[0-9]+/comments( --paginate)?$",
        "^gh api repos/[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+/pulls/[0-9]+/reviews/[0-9]+/comments( --paginate)? --jq '[^']*'$",
        "^gh api repos/[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+ --method POST -f parent_issue_id=[a-zA-Z0-9_=]+ /issues/[0-9]+/sub_issues$",
        "^gh api graphql -f query='(query([[:space:]({{])|[{])[^']*('\\\\''[^']*)*'$",
        "^gh api( --allow-escape-sequences)? ('[^']*'|[^ '-][^ ']*)( --paginate| --slurp| --allow-escape-sequences| -i| --include| --jq ('[^']*'|[^' ]+)| -q ('[^']*'|[^' ]+)| -H '[^']*'| --cache [0-9]+[smh])*$",
        "^gh issue (list|status|view)( |$)",
        "^gh issue (create|comment|develop|edit|reopen|close)( |$)",
        "^gh label (list|create)( |$)",
        "^gh pr list( |$)",
        "^gh pr status( |$)",
        "^gh pr checks( |$)",
        "^gh pr diff( |$)",
        "^gh pr view( |$)",
        "^gh pr create( |$)",
        "^gh pr checkout( |$)",
        "^gh pr comment( |$)",
        "^gh pr edit( |$)",
        "^gh pr ready( |$)",
        "^gh pr close( |$)",
        "^gh pr reopen( |$)",
        "^gh pr review( [0-9]+)? (--comment|--request-changes)( [^;&|<>$`]+)?$",
        "^gh run (list|view|watch|rerun|download|cancel)( |$)",
        "^gh repo view( |$)",
        "^gh repo clone [A-Za-z0-9_./-]+( [A-Za-z0-9._/-]+)?$",
        "^gh stack view( -s| --short)?$",
        "^gh stack init [a-zA-Z0-9_./][a-zA-Z0-9_./-]*( [a-zA-Z0-9_./][a-zA-Z0-9_./-]*)*$",
        "^gh stack add [a-zA-Z0-9_./][a-zA-Z0-9_./-]*$",
        "^gh stack submit --auto( --open)?$",
        "^gh stack push$",
        "^gh stack sync$",
        "^gh stack rebase( --continue| --abort)?$"
      ],
      "justification": "Allow GitHub reads and the reviewable writes the delivery workflow uses; other forms of an approved gh prefix change GitHub in ways the sandbox cannot undo."
    },
    {
      "programs": [
        "gh"
      ],
      "literal_words": true,
      "patterns": [
        "^gh api( (-H|--header) ('(Accept|X-GitHub-Api-Version): [^']*'|\"(Accept|X-GitHub-Api-Version): [^\"$`\\\\]*\"))* ('[^']*'|[^ '-][^ ']*)( --paginate| --slurp| -i| --include| --jq ('[^']*'|[^' ]+)| -q ('[^']*'|[^' ]+)| -H '[^']*'| --cache [0-9]+[smh]| (-H|--header) ('(Accept|X-GitHub-Api-Version): [^']*'|\"(Accept|X-GitHub-Api-Version): [^\"$`\\\\]*\"))*$"
      ],
      "justification": "Allow GitHub reads that ask for a media type or API version by header; every other word must be literal, so no expansion can add an option beside the header."
    },
    {
      "programs": [
        "curl",
        "wget"
      ],
      "literal_words": true,
      "patterns": [
        "^curl( -[sSfiIv]+)*( -X (GET|POST|PUT|PATCH|DELETE))?( -H '([Aa][Cc][Cc][Ee][Pp][Tt]|[Cc][Oo][Nn][Tt][Ee][Nn][Tt]-[Tt][Yy][Pp][Ee]|[Uu][Ss][Ee][Rr]-[Aa][Gg][Ee][Nn][Tt]):[^'[:cntrl:]]*')*( -d '([^'@][^']*)?')?( (-D|--dump-header) -)?( --compressed)?( -o /dev/null)?( (-w|--write-out) '[^']*')? (https?://(localhost|127\\.0\\.0\\.1|\\[::1\\])(:[0-9]+)?(/[A-Za-z0-9._/?&=%-]*)?|'https?://(localhost|127\\.0\\.0\\.1|\\[::1\\])(:[0-9]+)?(/[A-Za-z0-9._/?&=%-]*)?')$",
        "^wget (--help|--version)$"
      ],
      "justification": "Allow a single plain curl call, with value-less flags (-s -S -f -i -I -v) and fixed -X, -H, -d, -o, and single-quoted -w/--write-out diagnostic formats, stdout-only -D/--dump-header, and --compressed, to a local server named exactly localhost, 127.0.0.1, or [::1]; -o is limited to /dev/null, and -d cannot start with @ (file input). Only Accept, Content-Type, and User-Agent headers are allowed (case-insensitive, without control characters): local dev checks need response media selection, request body typing, and client identification, without credentials, cookies, or host/routing overrides; any assignment, redirect, wrapper, list, or option that follows redirects, reads a config file, or sets a proxy asks, and wget, which follows redirects by default, asks except for its help and version."
    },
    {
      "programs": [
        "herdr"
      ],
      "patterns": [
        "^herdr status( |$)",
        "^herdr --help( |$)",
        "^herdr --version( |$)",
        "^herdr pane list( |$)",
        "^herdr pane read( |$)",
        "^herdr pane current( |$)",
        "^herdr plugin list( |$)",
        "^herdr plugin log( |$)",
        "^herdr config check( |$)",
        "^herdr agent list( |$)",
        "^herdr api snapshot( |$)",
        "^herdr worktree create( --(cwd|branch|base|path|label|workspace) ('[^']*'|\"([^\"\\\\]|\\\\.)*\"|[^ '\"]+)| --(no-)?focus)*$",
        "^herdr pane split( --(pane|direction|ratio|cwd) ('[^']*'|\"([^\"\\\\]|\\\\.)*\"|[^ '\"]+)| --current| --(no-)?focus)*$",
        "^herdr agent start [a-z][a-z0-9_-]*( --kind (claude|codex)| --pane [^ ]+| --timeout [0-9]+)+$",
        "^herdr agent start [a-z][a-z0-9_-]*( --kind claude| --pane [^ ]+| --timeout [0-9]+)+ -- --model (sonnet|opus) --effort medium$",
        "^herdr agent prompt [a-z][a-z0-9_-]* ('[^']*'|\"([^\"\\\\]|\\\\.)*\"|[^ '\"]+)( --wait| --until [a-z]+| --timeout [0-9]+)*$",
        "^herdr workspace create( --(cwd|label) ('[^']*'|\"([^\"\\\\]|\\\\.)*\"|[^ '\"]+)| --(no-)?focus)*$",
        "^herdr workspace close [^ -][^ ]*$",
        "^herdr worktree remove --workspace [^ -][^ ]*$",
        "^herdr workspace list( |$)",
        "^herdr workspace get( |$)"
      ],
      "justification": "Allow Herdr reads and handing work to a new Claude or Codex session; repository trust, pane environments, other agent kinds, and driving existing panes run outside the sandbox and ask."
    },
    {
      "programs": [
        "herdr"
      ],
      "literal_words": true,
      "patterns": [
        "^herdr (agent (read|wait)|worktree (list|open)) --help$",
        "^herdr agent read [^ -][^ ]*( --(source|lines|format) [^ ]+| --ansi)*$",
        "^herdr agent wait [^ -][^ ]*( --until [a-z]+| --timeout [0-9]+)*$",
        "^herdr worktree list( --(workspace|cwd) ('[^']*'|\"([^\"\\\\]|\\\\.)*\"|[^ '\"]+))*$",
        "^herdr worktree open( --(workspace|cwd|path|branch|label) ('[^']*'|\"([^\"\\\\]|\\\\.)*\"|[^ '\"]+)| --(no-)?focus)*$"
      ],
      "justification": "Allow watching lanes and their worktrees; every word must be literal, so no expansion can add an option such as --trust-repository."
    }
  ]
}
