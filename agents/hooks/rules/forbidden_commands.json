{
  "version": 1,
  "rules": [
    {
      "patterns": [
        "(^|[[:space:]])([^[:space:]]*/)?\\.venv/bin/python([0-9.]*)?([[:space:]]|$)",
        "^git[[:space:]]+add[[:space:]]+(\\.|-A|--all)([[:space:]]|$)",
        "(^|[[:space:]])git[[:space:]]+add[[:space:]]+(\\.|-A|--all)([[:space:]]|$)",
        "^git[[:space:]]+commit([[:space:]].*)?[[:space:]]+(--no-verify|-n)([[:space:]]|$)",
        "(^|[[:space:]])git[[:space:]]+commit([[:space:]].*)?[[:space:]]+(--no-verify|-n)([[:space:]]|$)",
        "(^|[[:space:]])python3?([[:space:]]+-[A-Za-z]+)*[[:space:]]+-m[[:space:]]+(pip|ensurepip)([[:space:]]|$)"
      ],
      "justification": "Do not allow dependency, staging, or verification bypasses hidden inside otherwise approved command families."
    },
    {
      "patterns": [
        "(^|[[:space:]])find[[:space:]].*[[:space:]]-(delete|exec|execdir|ok|okdir|fprint|fprint0|fprintf|fls)([[:space:]]|$)"
      ],
      "justification": "Do not delete or execute through find; it is allowed as a read-only inspection command."
    },
    {
      "patterns": [
        "^herdr[[:space:]]+agent[[:space:]]+start([[:space:]].*)?[[:space:]]--([[:space:]]|$)"
      ],
      "exceptions": [
        "^herdr agent start [a-z][a-z0-9_-]*( --kind claude| --pane [^ ]+| --timeout [0-9]+)+ -- --model (sonnet|opus) --effort medium$"
      ],
      "justification": "Do not pass arguments to an agent Herdr starts, except the Sonnet or Opus model at medium effort for Claude lanes; others could switch off its sandbox, hooks, or approvals."
    }
  ]
}
