{
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Skill",
      "Read(~/.local/state/secretary/**)",
      "Read(~/ghq/github.com/furedea/dotfiles/**)",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Bash(gws calendar +agenda --help)",
      "Bash(gws calendar +agenda * --calendar * --format json)",
      "Bash(apple-mail --help)",
      "Bash(apple-mail * --help)",
      "Bash(apple-mail accounts)",
      "Bash(apple-mail mailboxes *)",
      "Bash(apple-mail unread *)",
      "Bash(apple-mail search *)",
      "Bash(apple-mail get *)",
      "Bash(curl --fail-with-body --silent --show-error *)",
      "Bash(jq *)",
      "Bash(date *)",
      "Write(~/.local/state/secretary/research-digest.json.tmp)",
      "Write(~/.local/state/secretary/tech-digest.json.tmp)",
      "Bash(mv ~/.local/state/secretary/research-digest.json.tmp ~/.local/state/secretary/research-digest.json)",
      "Bash(mv ~/.local/state/secretary/tech-digest.json.tmp ~/.local/state/secretary/tech-digest.json)"
    ],
    "deny": [
      "Bash(apple-mail mark-read *)",
      "Bash(apple-mail move *)",
      "Bash(apple-mail get *--include-body*)",
      "Bash(gws calendar events *)",
      "Bash(gws auth *)",
      "Bash(gws * create *)",
      "Bash(gws * delete *)",
      "Bash(gws * update *)",
      "Bash(gws * patch *)",
      "Bash(gws * insert *)",
      "Bash(gws * import *)",
      "Bash(gws * move *)",
      "Bash(curl *-X *)",
      "Bash(curl *--request*)",
      "Bash(curl * -d *)",
      "Bash(curl *--data *)",
      "Bash(curl *--data-binary*)",
      "Bash(curl *--form*)",
      "Bash(curl *--upload-file*)",
      "Bash(curl * -o *)",
      "Bash(curl * -O*)",
      "Bash(curl *--output*)",
      "Bash(*>*)",
      "Bash(*tee *)",
      "Bash(git *)",
      "Bash(nix *)",
      "Bash(osascript *)",
      "Edit",
      "NotebookEdit",
      "Write(~/ghq/**)",
      "Artifact",
      "Agent"
    ]
  }
}
